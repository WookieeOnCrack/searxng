{
    // See https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "backend.app:app",
                "--reload",
                "--reload-dir", 
                "./backend",
                "--reload-dir", 
                "./searx" ,
                "--reload-dir" ,
                "./tests",
                "--loop",
                "asyncio",
                "--host",
                "127.0.0.1",
                "--port",
                "8888"
            ],
            "jinja": true,
            "justMyCode": true,
            "python": "${workspaceFolder}/local/py3/bin/python",
        }
    ]
}
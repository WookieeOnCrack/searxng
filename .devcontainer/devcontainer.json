{
  "build": {
    "args": {
      "DEBIAN_CODENAME": "bookworm"
    },
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli": {},
    "ghcr.io/devcontainers/features/docker-in-docker": {}
  },
  "containerEnv": {
    "UV_PROJECT_ENVIRONMENT": "${containerWorkspaceFolder}/local/py3",
    "UV_LINK_MODE": "copy"
  },
  "mounts": [
  "source=searxng-uv-cache,target=/home/vscode/.cache/uv,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "ms-python.pylint",
        "ms-python.black-formatter",
        "charliermarsh.ruff",
        "detachhead.basedpyright"
      ],
      "settings": {
        "files.autoSave": "off",
        "remote.otherPortsAttributes": {
          "protocol": "https"
        },
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/local/py3/bin/python3",
        "python.terminal.activateEnvironment": true,
        "basedpyright.importStrategy": "fromEnvironment",
        "black-formatter.path": ["${containerWorkspaceFolder}/local/py3/bin/black"],
        "pylint.path": ["${containerWorkspaceFolder}/local/py3/bin/pylint"],
        "ruff.importStrategy": "fromEnvironment"
      }
    }
  },
  "forwardPorts": [8000, 8888],
  "portsAttributes": {
    "8000": {"label": "Sphinx documentation"},
    "8888": {"label": "SearXNG"}
  },
  "postCreateCommand": "uv sync"
}
